apiVersion: v1alpha1
kind: DiscoveryServiceConfig
name: default
endpoint: https://discovery.talos.dev/
---
apiVersion: v1alpha1
kind: KubeClusterConfig
clusterName: talos-lab
endpoint: https://${cluster_endpoint}:6443
---
apiVersion: v1alpha1
kind: DiscoveryIdentityConfig
clusterID: ${talos.cluster_id}
clusterSecret: ${talos.cluster_secret}
---
version: v1alpha1
debug: false
persist: true
machine:
  token: ${talos.trustd_token}
  type: ${nodeRole}
  ca:
    crt: ${talos.machine_secret_certs.os.cert}
  %{ if nodeRole == "controlplane" }
    key: ${talos.machine_secret_certs.os.key}
  %{ endif }

  certSANs:
  %{ for SAN in machineCertSANs ~}
    - ${SAN}
  %{ endfor ~}

cluster:
  token: ${k8s.k8s_bootstrap_token}

  %{ if nodeRole == "controlplane" }
  etcd:
    ca:
      crt: ${k8s.etcd_ca_cert}
      key: ${k8s.etcd_ca_key}
  %{ endif }

%{ if nodeRole == "worker" }
---
apiVersion: v1alpha1
kind: KubeAPIServerCAConfig
acceptedCAs:
  - |
    ${k8s.k8s_ca_cert}
%{ endif }
---
apiVersion: v1alpha1
kind: SecurityProfileConfig
workloadIsolation: true
---
apiVersion: v1alpha1
kind: KubePrismConfig
port: 7445
---
apiVersion: v1alpha1
kind: HostnameConfig
auto: stable
---
apiVersion: v1alpha1
kind: VolumeConfig
name: STATE
encryption:
  provider: luks2
  keys:
    - nodeID: {}
      slot: 0
---
apiVersion: v1alpha1
kind: VolumeConfig
name: EPHEMERAL
encryption:
  provider: luks2
  keys:
    - nodeID: {}
      slot: 0
---
apiVersion: v1alpha1
kind: KubeNodeConfig
nodeIP:
  validSubnets:
      - 10.0.0.0/16
    %{ if ipv6_enabled }
      - 2000::/3
    %{ endif }
labels:
%{ for k,v in nodeLabels ~}
  ${k}: ${v}
%{ endfor ~}

# annotations:
#     customer.io/rack: r13a25
# taints:
#     node-role.kubernetes.io/control-plane: NoSchedule
---
apiVersion: v1alpha1
kind: ResolverConfig
hostDNS:
  enabled: true
  forwardKubeDNSToHost: true
  resolveMemberNames: true
nameservers:
  - address: 1.1.1.1 # Cloudflare
  - address: 1.0.0.1 # Cloudflare
  # - address: 2606:4700:4700::1111 # Cloudflare
  # - address: 2606:4700:4700::1001 # Cloudflare
  # - address: 2a01:4f8:c2c:123f::1 # Nat64
  # - address: 2a01:4f9:c010:3f02::1 # Nat64
---
apiVersion: v1alpha1
kind: KubeNetworkConfig
dnsDomain: cluster.local
podSubnets:
    - 10.244.0.0/16
  %{ if ipv6_enabled }
    - fd00:10:244::/48
  %{ endif }
serviceSubnets:
    - 10.96.0.0/12
    %{ if ipv6_enabled }
    - fd00:20:123::/112
    %{ endif }
---
apiVersion: v1alpha1
kind: KubeletConfig
image: ghcr.io/siderolabs/kubelet:${cluster_version}
config:
  serverTLSBootstrap: true
  serializeImagePulls: false
  maxParallelImagePulls: 8
  nodeStatusMaxImages: -1
  imageMinimumGCAge: 5m
  imageMaximumGCAge: 1h
  volumeStatsAggPeriod: 5m
  enableProfilingHandler: false
  enableDebugFlagsHandler: false
  maxPods: 220
  readOnlyPort: 0
  failSwapOn: true
extraArgs:
  cloud-provider: external
  rotate-server-certificates: true
defaultRuntimeSeccompProfileEnabled: true
---
apiVersion: v1alpha1
kind: StaticHostConfig
name: ${controlplane_internal_ip}
hostnames:
    - ${controlplane_endpoint_internal}
---
apiVersion: v1alpha1
kind: KubeSpanConfig
enabled: false
---
apiVersion: v1alpha1
kind: SysctlConfig
params:
    # Some defaults https://github.com/siderolabs/talos/blob/main/internal/app/machined/pkg/controllers/runtime/kernel_param_defaults.go
    user.max_user_namespaces: 15000
    net.ipv4.tcp_fastopen: 1
    net.ipv4.icmp_echo_ignore_broadcasts: 1
    vm.overcommit_memory: 1
    vm.nr_hugepages: "1024"
    kernel.pid_max: 4194304
    kernel.randomize_va_space: 2
    net.ipv4.tcp_syncookies: 1
    net.ipv4.icmp_ignore_bogus_error_responses: 1
    net.ipv4.tcp_rfc1337: 1
    net.ipv4.ip_local_port_range: 10240 65535

%{ if extra_ca != null }
---
apiVersion: v1alpha1
kind: TrustedRootsConfig
name: extra-ca
certificates: |-
  ${extra_ca}
%{ endif }
